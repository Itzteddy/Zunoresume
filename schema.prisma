generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum AuthProvider {
  CREDENTIALS
  GOOGLE
}

enum AIRequestStatus {
  SUCCESS
  ERROR
}

model User {
  id             String          @id @default(cuid())
  name           String
  email          String          @unique
  emailVerified  DateTime?
  passwordHash   String?
  image          String?
  title          String?
  phone          String?
  location       String?
  linkedin       String?
  github         String?
  portfolio      String?
  website        String?
  role           Role            @default(USER)
  provider       AuthProvider    @default(CREDENTIALS)
  isDisabled     Boolean         @default(false)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  accounts       Account[]
  sessions       Session[]
  resumes        Resume[]
  settings       UserSettings?
  aiRequests     AIRequest[]

  @@index([email])
}

model Account {
  id                String       @id @default(cuid())
  userId            String
  provider          String
  providerAccountId String
  refreshToken      String?
  accessToken       String?
  expiresAt         Int?
  createdAt         DateTime     @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id          String   @id @default(cuid())
  sessionToken String  @unique
  userId      String
  expiresAt   DateTime
  ip          String?
  userAgent   String?
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model UserSettings {
  id               String    @id @default(cuid())
  userId           String    @unique
  theme            String    @default("system")
  notifyResumeTips Boolean   @default(true)
  notifyNewsletter Boolean   @default(false)
  updatedAt        DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Template {
  id           String   @id @default(cuid())
  slug         String   @unique
  name         String
  category     String
  description  String?
  atsScore     Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  resumes Resume[]
}

model Resume {
  id          String    @id @default(cuid())
  userId      String
  title       String
  templateId  String?
  template    Template? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  fullName    String?
  professionalTitle String?
  email       String?
  phone       String?
  location    String?
  linkedin    String?
  github      String?
  portfolio   String?
  website     String?
  photo       String?
  summary     String?
  atsScore    Int?
  lastEditedStep Int?   @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  educations    Education[]
  experiences   Experience[]
  projects      Project[]
  skills        Skill[]
  certifications Certification[]
  achievements  Achievement[]
  internships   Internship[]
  languages     Language[]
  interests     Interest[]
  customSections CustomSection[]
  atsAnalyses   ATSAnalysis[]
  jobMatches    JobMatch[]
  analytics     Analytics[]

  @@index([userId])
}

model Education {
  id          String  @id @default(cuid())
  resumeId    String
  school      String
  degree      String?
  field       String?
  startDate   String?
  endDate     String?
  grade       String?
  description String?
  order       Int     @default(0)

  resume Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)
}

model Experience {
  id          String   @id @default(cuid())
  resumeId    String
  company     String
  role        String?
  location    String?
  startDate   String?
  endDate     String?
  current     Boolean  @default(false)
  description String?
  bullets     Json?
  order       Int      @default(0)

  resume Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)
}

model Internship {
  id          String   @id @default(cuid())
  resumeId    String
  company     String
  role        String?
  startDate   String?
  endDate     String?
  current     Boolean  @default(false)
  description String?
  bullets     Json?
  order       Int      @default(0)

  resume Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)
}

model Project {
  id          String   @id @default(cuid())
  resumeId    String
  name        String
  link        String?
  tech        String?
  startDate   String?
  endDate     String?
  description String?
  bullets     Json?
  order       Int      @default(0)

  resume Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)
}

model Skill {
  id       String @id @default(cuid())
  resumeId String
  name     String
  level    String?
  order    Int    @default(0)

  resume Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)
}

model Certification {
  id           String  @id @default(cuid())
  resumeId     String
  name         String
  issuer       String?
  year         String?
  url          String?
  order        Int     @default(0)

  resume Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)
}

model Achievement {
  id        String  @id @default(cuid())
  resumeId  String
  title     String
  detail    String?
  year      String?
  order     Int     @default(0)

  resume Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)
}

model Language {
  id       String @id @default(cuid())
  resumeId String
  name     String
  level    String?
  order    Int    @default(0)

  resume Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)
}

model Interest {
  id       String @id @default(cuid())
  resumeId String
  name     String
  order    Int    @default(0)

  resume Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)
}

model CustomSection {
  id       String @id @default(cuid())
  resumeId String
  title    String
  items    Json?
  order    Int    @default(0)

  resume Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)
}

model AIRequest {
  id        String         @id @default(cuid())
  userId    String
  type      String
  model     String?
  status    AIRequestStatus @default(SUCCESS)
  promptLength Int?
  error     String?
  createdAt DateTime       @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model ATSAnalysis {
  id              String   @id @default(cuid())
  resumeId        String
  score           Int
  breakdown       Json?
  strengths       Json?
  weaknesses      Json?
  recommendations Json?
  missingKeywords Json?
  createdAt       DateTime @default(now())

  resume Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  @@index([resumeId])
}

model JobMatch {
  id             String   @id @default(cuid())
  resumeId       String
  jobDescription String
  matchPercent   Int
  matchedSkills  Json?
  missingSkills  Json?
  keywordMatches Json?
  recommendations Json?
  createdAt      DateTime @default(now())

  resume Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  @@index([resumeId])
}

model Analytics {
  id          String   @id @default(cuid())
  resumeId    String?
  userId      String?
  event       String
  templateId  String?
  meta        Json?
  createdAt   DateTime @default(now())

  resume Resume? @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  @@index([event])
  @@index([createdAt])
}
