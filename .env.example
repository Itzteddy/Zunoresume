# ============================================================
# ZUNO — Environment Variables
# Copy this file to `.env` (local) and configure in Vercel.
# NEVER commit real secret values.
# ============================================================

# --- Database -------------------------------------------------
# Local development uses SQLite via prisma/schema.sqlite.prisma:
#   file:./dev.db
# Production example:
#   postgresql://user:password@host:5432/zuno?sslmode=require
DATABASE_URL="file:./dev.db"

# --- Auth ------------------------------------------------------
# Generate a secure value with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-random-64-char-string"

# Base URL of the app (used for emails, OAuth redirects).
# MUST NOT end with a trailing slash. Local: http://localhost:3000
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Server-side alias for the app URL (used by server-only OAuth helpers).
# If set, this takes precedence over NEXT_PUBLIC_APP_URL for Google OAuth.
APP_URL="http://localhost:3000"

# --- Google OAuth (https://console.cloud.google.com/apis/credentials) --------
# OAuth 2.0 Client ID (public; safe to embed) and Client Secret (server-side
# ONLY; never ship to the frontend).
GOOGLE_CLIENT_ID="your_google_client_id"
GOOGLE_CLIENT_SECRET="your_google_client_secret"
#
# The app's Google callback path is: /api/auth/google/callback
# So with APP_URL="http://localhost:3000" the redirect URI Google receives is:
#   http://localhost:3000/api/auth/google/callback
# Register EXACTLY that URI as an "Authorized redirect URI" in Google Cloud,
# and add "http://localhost:3000" as an "Authorized JavaScript origin".
# Same rule in production: APP_URL must equal your deployed domain.

# --- Email -----------------------------------------------------
# Use Resend (https://resend.com) for transactional emails.
# If empty, verification/reset links are logged to the console in dev.
RESEND_API_KEY=""
EMAIL_FROM="Zuno <onboarding@resend.dev>"

# --- AI (OpenAI-compatible) ------------------------------------
# Any OpenAI-compatible endpoint works (OpenAI, Groq, OpenRouter, ...).
# Gemini is supported through Google's OpenAI-compatible endpoint:
#   AI_BASE_URL="https://generativelanguage.googleapis.com/v1beta/openai"
#   AI_MODEL="gemini-3.6-flash"
AI_API_KEY=""
AI_MODEL="gemini-3.6-flash"
AI_BASE_URL="https://generativelanguage.googleapis.com/v1beta/openai"

# --- Storage (Vercel Blob) -------------------------------------
# Get a token at https://vercel.com/docs/blob/manage-blobs
BLOB_READ_WRITE_TOKEN=""
BLOB_PREFIX="zuno"

# --- Misc ------------------------------------------------------
# Comma-separated list of admin emails (admin panel access).
ADMIN_EMAILS=""

# Rate limiting window for AI endpoints (requests per window).
AI_RATE_LIMIT_PER_WINDOW="30"
AI_RATE_LIMIT_WINDOW_MS="60000"
